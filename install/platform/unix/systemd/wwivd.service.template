[Unit]
Description=wwivd: WWIV UNIX Daemon
[Service]
WorkingDirectory=${WWIV_DIR}
ExecStart=${WWIV_DIR}/wwivd
# On stop, signal only wwivd: it hangs up each node so the BBS logs its
# caller off, and waits for them. Anything still running when wwivd exits
# is then killed.
KillMode=mixed
EnvironmentFile=/etc/wwiv/config
[Install]
WantedBy=multi-user.target

